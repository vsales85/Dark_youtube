# Copie este arquivo para ".env" e preencha. NUNCA envie o .env para o GitHub.

# Obrigatoria: roteiros e textos (gratis) - crie em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: fotos/videos de banco gratis - https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Opcional: baixar modelos de imagem do Hugging Face - https://huggingface.co/settings/tokens
HF_TOKEN=

# Opcional: pasta dos modelos/mapas (padrao: pasta "dados" dentro do app)
# DARK_MODELOS=D:\modelos_imagem

# Opcional: integracao com o SupoClip (vozes do Gemini e voz clonada)
# SUPOCLIP_ENV=D:\SupoClip\.env
# SUPOCLIP_USER_ID=

# Opcional: reserva automatica do roteiro no PC (Ollama). Se o Gemini falhar/demorar, o app usa este modelo.
# Instale em https://ollama.com e rode: ollama pull qwen2.5:14b
# OLLAMA_MODELO=qwen2.5:14b
