+def _transcribe_with_faster_whisper(
+    audio_path: Path, model_name: str, language: Optional[str]
+) -> Dict[str, Any]:
+    """CTranslate2 Whisper (int8 on CPU): several times faster than openai-whisper.
+
+    Returns the same dict shape as openai-whisper's ``transcribe``.
+    """
+    from faster_whisper import WhisperModel
+
+    cache_key = f"faster:{model_name}"
+    if cache_key not in _WHISPER_MODEL_CACHE:
+        logger.info("Loading faster-whisper model: %s (int8, cpu)", model_name)
+        _WHISPER_MODEL_CACHE[cache_key] = WhisperModel(
+            model_name, device="cpu", compute_type="int8", cpu_threads=os.cpu_count() or 4
+        )
+    model = _WHISPER_MODEL_CACHE[cache_key]
+    logger.info(
+        "Starting faster-whisper transcription with model: %s (language: %s)",
+        model_name,
+        language or "auto",
+    )
+    segments, info = model.transcribe(
+        str(audio_path), word_timestamps=True, language=language, vad_filter=True, beam_size=1
+    )
+    result_segments = [
+        {
+            "start": segment.start,
+            "end": segment.end,
+            "text": segment.text,
+            "words": [
+                {"word": w.word, "start": float(w.start), "end": float(w.end), "probability": w.probability}
+                for w in segment.words or []
+            ],
+        }
+        for segment in segments
+    ]
+    return {
+        "segments": result_segments,
+        "text": "".join(s["text"] for s in result_segments),
+        "language": info.language,
+    }
+
+
